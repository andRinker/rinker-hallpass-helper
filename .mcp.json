{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--executablePath=${CHROME_PATH:-/opt/pw-browsers/chromium}",
        "--headless",
        "--isolated",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--enable-unsafe-extension-debugging",
        "--categoryExtensions",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
