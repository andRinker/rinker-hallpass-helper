{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--categoryExtensions",
        "--headless",
        "--isolated",
        "--executablePath=/opt/pw-browsers/chromium",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--load-extension=./hallpass-helper",
        "--ignoreDefaultChromeArg=--disable-extensions",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
